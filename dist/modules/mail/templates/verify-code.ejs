<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Code</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f3f4f6;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #333;
    }

    .container {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      max-width: 600px;
      width: 100%;
      padding: 30px;
      text-align: center;
    }

    .header {
      font-size: 2em;
      color: #4CAF50;
      margin-bottom: 20px;
    }

    .code-box {
      background-color: #4CAF50;
      color: white;
      font-size: 1.5em;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
      display: inline-block;
    }

    .message {
      font-size: 1.2em;
      margin-bottom: 25px;
      color: #555;
    }

    .footer {
      font-size: 1em;
      color: #777;
    }

    .footer a {
      color: #4CAF50;
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }

    .button {
      background-color: #4CAF50;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      font-size: 1.1em;
      cursor: pointer;
      text-decoration: none;
    }

    .button:hover {
      background-color: #45a049;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1 class="header">Hello <%= email %>
    </h1>
    <p class="message">Thank you for registering with us. Please verify your email by entering the following code.</p>
    <div class="code-box">
      <%= code %>
    </div>
    <p class="message">If you didn't request this, please ignore this email.</p>
    <p class="footer">If you have any questions, feel free to <a href="mailto:support@yourwebsite.com">contact us</a>.
    </p>
  </div>

</body>

</html>